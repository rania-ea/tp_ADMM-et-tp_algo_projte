# algorithme ADMM pour LASSO
from numpy import linalg as la
import matplotlib.pyplot as plt
import numpy as np
from scipy.sparse import rand as sprandn

from scipy.linalg import  cho_solve, cho_factor
import time 

# Paramètres

### example 3
m = 50    # nombre d'individus
n = 100   # nombre d'attributs
p = 100 / (m * n)  # densité de la matrice A

# Génération de x_0 : vecteur clairsemé de taille n
x_0 = sprandn(n, 1, density=p, format='csr', dtype=float)
x_0.data = np.random.randn(len(x_0.data))  # valeurs normales centrées réduites

# Matrice A de taille m x n avec colonnes normalisées
A = np.random.randn(m, n)
A = A @ np.diag(1 / np.sqrt(np.sum(A**2, axis=0)))  # normalisation des colonnes

# Calcul de b
b = (A @ x_0.toarray()).ravel() + np.sqrt(0.001) * np.random.randn(m)



# imoprtation 

