#Â on affiche la courbe de la fonction cout pour visualiser si on minimise bien la fonction 
# fonction cout
def cout(A,x,b,lmbda):
    return 1/2 * la.norm( np.dot(A, x)- b)**2 + lmbda * la.norm(x)

# création de la liste des image de la fonction cout ( normalement autant element que adssice)
im_cout = []

for x_k in x_k_liste: 
    im_cout= np.append(im_cout,cout(A,x_k.reshape(n,1),b,lmbda))
    
print("temps ecoulé %f " %(time.time()-start_time))
plt.plot(adssice,im_cout,label='Lasso')
plt.legend()
