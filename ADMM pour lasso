print(np.shape(A),np.shape(b))

# Calcul de lambda_max et lambda
lambda_max = np.linalg.norm(A.T @ b, ord=np.inf)
lmbda = 0.1 * lambda_max

#fonction sto 
n=np.size(A[1,:])
a = np.array(n)
def sto(kappa,a):
 end = np.zeros(shape=np.size(a))
 for i in range (np.size(a)):
    if a[i] > kappa :
        end[i] = a[i]-kappa
    if a[i] < -kappa:
        end[i] = a[i]+kappa
 return end

def sto_efficace(kappa,a):
 return np.sign(a) * np.maximum(0, np.abs(a) - kappa)


r = 0.1
epsilon = 10**(-6)  

start_time =time.time ()
x_k = np.zeros(n)
z_k = np.zeros(n)
u_k = np.zeros(n)
x= np.zeros(n) 
z = np.zeros(n) 
u = np.zeros(n)
stop = 1
norminfini=1
k=0
lg_A = np.shape(A)[1]
A_r = ( np.transpose(A) @ A ) + (r * np.identity(lg_A))
R, low = cho_factor(A_r)
adssice = []
x_k_liste = []
while stop > epsilon and norminfini > 1e-10 and k < 5000:
    
    s = r*(z_k - u_k)

    x_k = x = cho_solve((R, low),  np.transpose(A) @ b + s)

    z_k = sto_efficace(lmbda/r,x_k  + u_k )

    u_k = u_k + x_k - z_k 

    err_rel_x = la.norm(x - x_k)
    err_rel_z = la.norm(z - z_k)
    err_rel_u = la.norm(u-u_k)
    norm_x = la.norm(x_k)
    norm_z = la.norm(z_k)
    norm_u = la.norm(u_k)
    stop = (err_rel_x + err_rel_z + err_rel_u) / (norm_x+ norm_z + norm_u)
    x = x_k
    z = z_k
    u = u_k
    norminfini = la.norm(x-z)
    k= k+1
    adssice = np.append(adssice,k)
    x_k_liste.append(x_k)
